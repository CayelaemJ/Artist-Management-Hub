# Configure runtime credentials in Render environment settings, not Git.
# Never place real tokens or password-bearing URLs in a committed .env file.
DATABASE_URL=
ADMIN_TOKEN=
GROQ_API_KEY=
GROQ_MODEL=
PORT=10000
# Set to 1 ONLY after checking the trusted Render ingress appends/rewrites
# X-Forwarded-For and there is exactly one trusted reverse proxy.
# TRUST_PROXY_HOPS=1
